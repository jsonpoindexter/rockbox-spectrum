+    w->viewport = PTRTOSKINOFFSET(skin_buffer, curr_vp);
+    w->next = data->spectrum_widgets;
+    data->spectrum_widgets = PTRTOSKINOFFSET(skin_buffer, w);
+    token->value.data = PTRTOSKINOFFSET(skin_buffer, w);
