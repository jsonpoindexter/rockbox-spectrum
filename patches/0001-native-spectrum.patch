+#ifdef HAVE_SPECTRUM
+/* Rapid animation uses visibility from the latest ordinary skin render.
+ * Avoid re-evaluating unrelated images, labels, and viewports for every spectrum frame. */
+void skin_render_spectrum(struct gui_wps *gwps)
+{
+    struct wps_data *data = gwps->data;
+    struct screen *display = gwps->display;
+    skin_buffer = get_skin_buffer(data);
+    struct spectrum_widget *w = SKINOFFSETTOPTR(skin_buffer, data->spectrum_widgets);
+    while (w) {
+        if (w->visible) {
+            struct skin_viewport *vp = SKINOFFSETTOPTR(skin_buffer, w->viewport);
+            if (vp && !(vp->hidden_flags & (VP_NEVER_VISIBLE | VP_DRAW_HIDDEN))) {
+                display->set_viewport_ex(&vp->vp, VP_FLAG_VP_SET_CLEAN);
+                if (spectrum_draw(display, w, &vp->vp)) {
+                    struct spectrum_rect dirty;
+                    spectrum_get_dirty(w, &dirty);
+                    uint32_t start = spectrum_clock_us();
+                    display->update_viewport_rect(dirty.x, dirty.y, dirty.width, dirty.height);
+                    spectrum_record_submission(spectrum_clock_us() - start);
+                }
+            }
+        }
+        w = SKINOFFSETTOPTR(skin_buffer, w->next);
+    }
+    display->set_viewport_ex(NULL, VP_FLAG_VP_SET_CLEAN);
+}
